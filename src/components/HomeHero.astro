---
import backgroundSmall from '../assets/home-background-390.avif';
import backgroundLarge from '../assets/home-background-520.avif';
import assets from '../assets/official-assets.json';
---

<div class="home-hero">
  <div class="scene-composition">
    <img
      class="scene"
      src={backgroundSmall.src}
      srcset={`${backgroundSmall.src} 390w, ${backgroundLarge.src} 520w`}
      sizes="(max-height: 720px) 44vh, (max-width: 520px) 100vw, 520px"
      width={backgroundLarge.width}
      height={backgroundLarge.height}
      alt=""
      aria-hidden="true"
      fetchpriority="high"
      loading="eager"
    />

    <header class="identity">
      <h1 id="home-title" class="brand">
          <img class="brand-image" src={assets.logo.avif} width={assets.logo.width} height={assets.logo.height}
            alt="Checkpoint CCXP26" loading="eager" fetchpriority="high" decoding="async" />
      </h1>
      <p class="subtitle">Nosso diário de aventuras<br />na CCXP26!</p>
    </header>

    <div class="character-stage">
      <div class="character-composition" data-character-composition data-current data-level-index="0">
      <slot name="characters">
        <img class="character character-juh" src={assets.juh.avif} width={assets.juh.width} height={assets.juh.height} alt="Juh em pixel art" loading="eager" decoding="async" />
        <img class="character character-atila" src={assets.atila.avif} width={assets.atila.width} height={assets.atila.height} alt="Átila em pixel art" loading="eager" decoding="async" />
      </slot>
      </div>
    </div>
  </div>

  <div class="welcome page-container">
    <slot name="progress" />

    <div class="mascot-composition">
      <div class="mascot"><slot name="mascot">
        <img src={assets.korok.avif} width={assets.korok.width} height={assets.korok.height} alt="" aria-hidden="true" loading="eager" decoding="async" />
      </slot></div>
      <div class="speech-bubble">
        <p class="mascot-message">
          <span class="greeting">Yahaha!</span>
          <span>Você nos encontrou!</span>
        </p>
      </div>
    </div>

    <p class="scroll-hint">
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
        <path d="m5 5 9 9 9-9M5 14l9 9 9-9" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span>Role para participar</span>
    </p>
  </div>
</div>

<style>
  .home-hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    gap: clamp(var(--space-3), 2cqh, var(--space-6));
    width: 100%;
    max-width: var(--scene-max);
    min-height: 100%;
    margin-inline: auto;
  }

  .scene-composition {
    position: relative;
    /* Stable stacking even while parallax creates a transform context. The
       raster's decorative tail extends beyond this box, behind .welcome. */
    z-index: 0;
    display: grid;
    flex-shrink: 0;
    grid-template: auto minmax(var(--space-16), 1fr) / minmax(0, 1fr);
    justify-items: center;
    width: min(100%, 49cqh);
    /* Includes the entire ground; the artwork's blank tail stays decorative. */
    aspect-ratio: 877 / 1008;
  }

  .scene {
    position: absolute;
    z-index: -1;
    inset: 0 0 auto;
    width: 100%;
    height: auto;
    aspect-ratio: 877 / 1794;
    mask-image:
      linear-gradient(to right, transparent, #000 var(--space-6), #000 calc(100% - var(--space-6)), transparent),
      linear-gradient(to bottom, transparent, #000 var(--space-6), #000 calc(100% - var(--space-20)), transparent);
    mask-composite: intersect;
  }

  .identity {
    container-type: inline-size;
    width: min(calc(100cqi - 2 * var(--content-gutter)), var(--content-max));
    padding-top: clamp(var(--space-6), 5cqh, var(--space-12));
    text-align: center;
  }

  .brand { width: min(86cqi, var(--logo-max-width)); margin-inline: auto; line-height: 1; }
  .brand-image { width: 100%; height: auto; }
  .subtitle { margin-top: var(--space-3); color: var(--color-text); font-size: clamp(17px, 4.5cqi, 19px); font-weight: 500; line-height: 1.4; }

  .character-stage {
    --character-height: clamp(112px, 25.2cqh, 216px);
    position: absolute;
    inset-inline: 0;
    bottom: 6%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: var(--space-1);
    height: var(--character-height);
  }
  .character-stage :global(.character-composition) { position:absolute; inset:0; display:flex; justify-content:center; align-items:flex-end; gap:var(--space-1); }
  .character-stage :global(.character) { height: var(--character-height); width: auto; max-width: 46%; object-fit:contain; }
  .character-stage :global(.character-couple) { max-width: 95%; }

  .welcome {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto auto 1fr;
    flex: 1;
    gap: clamp(var(--space-3), 4.4cqh, var(--space-10));
    padding-bottom: clamp(var(--space-3), 3cqh, var(--space-6));
  }

  .mascot-composition {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.8fr);
    align-items: end;
    gap: var(--space-2);
  }

  .mascot { position: relative; align-self: stretch; }
  .mascot img { position: absolute; right: 0; bottom: calc(-1 * var(--space-2)); height: clamp(88px, 13.5cqh, 128px); width: auto; max-width: none; }
  .speech-bubble {
    --bubble-border: 1px;
    position: relative;
    min-width: 0;
    width: min(100%, 280px);
    justify-self: end;
    border: var(--bubble-border) solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }
  .speech-bubble::before {
    content: '';
    position: absolute;
    left: calc(-1 * var(--space-2));
    top: 50%;
    width: var(--space-4);
    height: var(--space-4);
    border-left: var(--bubble-border) solid var(--color-border);
    border-bottom: var(--bubble-border) solid var(--color-border);
    background: var(--color-surface);
    transform: translateY(-50%) rotate(45deg);
  }
  .mascot-message {
    position: relative;
    display: grid;
    gap: var(--space-1);
    justify-items: center;
    /* The border belongs to the existing inset budget, keeping the approved
       outer height and avoiding a two-pixel internal scroll on 390px phones. */
    padding: calc(var(--space-4) - var(--bubble-border)) calc(var(--space-5) - var(--bubble-border)) calc(var(--space-4) - var(--bubble-border)) calc(var(--space-6) - var(--bubble-border));
    text-align: center;
    font-size: clamp(16px, 4.5cqi, 18px);
    line-height: 1.3;
  }
  .greeting { color: var(--color-olive); font: italic 700 clamp(28px, 4.8cqh, 40px)/1.1 var(--font-ui); }
  .scroll-hint { display: grid; align-self: end; justify-items: center; gap: var(--space-1); font-size: 14px; text-align: center; }
  .scroll-hint svg {
    color: var(--color-olive);
    /* Suggests the upward swipe that advances to the next screen. */
    animation: pull-hint 1.6s ease-in-out infinite;
  }

  @keyframes pull-hint {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  @container (height < 740px) {
    .welcome { gap: clamp(var(--space-3), 3.3cqh, var(--space-6)); }
    .character-stage { --character-height: clamp(112px, 24cqh, 200px); }
  }

  @media (max-height: 720px) {
    .scene-composition { box-sizing: content-box; width: min(100%, 44cqh); padding-bottom: var(--space-5); }
    .scene { top: var(--space-5); }
    .character-stage { --character-height: clamp(100px, 20cqh, 136px); }
    .identity { padding-top: var(--space-4); }
    .brand { width: min(80cqi, 320px); }
    .welcome { gap: var(--space-4); }
    .mascot-message { padding-block: calc(var(--space-3) - var(--bubble-border)); font-size: 16px; }
    .scroll-hint svg { width: 24px; height: 24px; }
  }

  @media (max-width: 319px) {
    .mascot-composition { grid-template-columns: minmax(0, 1fr); }
    .mascot { display: none; }
    .greeting { font-size: 24px; }
  }

</style>
