---
import assets from '../assets/official-assets.json';
import SectionHeader from './SectionHeader.astro';
import RecentPhotos from './RecentPhotos.astro';
---

<div class="fotos-screen page-container">
  <SectionHeader
    icon={assets.cameraFotos}
    title="Fotos"
    subtitle="Compartilhe seus flagras da gente na CCXP!"
    titleId="photos-title"
    reward="+2 XP ao enviar uma foto"
  />

  <div class="section-content">
    <div class="photo-panel">
      <h3 class="photo-panel-title section-content-title">Flagras mais recentes</h3>
      <RecentPhotos photos={[]} />
    </div>
  </div>

  <div class="photo-actions">
    <div class="photo-choices" data-photo-choices>
    <button type="button" class="button-primary" data-photo-trigger>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M13.997 4a2 2 0 0 1 1.76 1.05l.486.9A2 2 0 0 0 18.003 7H20a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h1.997a2 2 0 0 0 1.759-1.048l.489-.904A2 2 0 0 1 10.004 4z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="12" cy="13" r="3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      Tirar foto
    </button>
    <button type="button" class="button-secondary photo-gallery" data-photo-gallery>Escolher da galeria</button>
    </div>
    <input type="file" accept="image/*" capture="environment" class="visually-hidden" data-photo-camera aria-label="Tirar uma fotografia" />
    <input type="file" accept="image/*" id="photo-input" class="visually-hidden" data-photo-input aria-label="Selecionar fotografia" />

    <dialog class="photo-dialog" data-photo-preview aria-labelledby="photo-dialog-title" aria-describedby="photo-dialog-status">
      <div class="photo-preview">
        <h3 id="photo-dialog-title" class="photo-dialog-title">Sua foto</h3>
        <div class="photo-crop" data-photo-crop tabindex="0" role="group" aria-label="Posição da foto. Arraste ou use as setas para ajustar o enquadramento.">
          <img class="photo-preview-image" data-photo-preview-image alt="Prévia da fotografia dentro da moldura" draggable="false" />
          <img class="photo-crop-frame" src={assets.polaroidFrame.src} alt="" aria-hidden="true" draggable="false" />
        </div>
        <p class="photo-crop-hint" data-photo-crop-hint>Arraste a foto para ajustar o enquadramento</p>
        <p id="photo-dialog-status" class="photo-preview-status" role="status" aria-live="polite">
          Prévia local. A foto será publicada após o envio.
        </p>
        <label class="photo-consent">
          <input type="checkbox" data-photo-consent />
          <span>Concordo que minha foto seja publicada neste site e usada no álbum do projeto, e que tenho direito de uso da imagem das pessoas nela. <a href="/privacidade" target="_blank" rel="noopener">Aviso de privacidade</a></span>
        </label>
        <button type="button" class="button-primary" data-photo-submit>Enviar foto</button>
        <button type="button" class="button-secondary" data-photo-clear>Escolher outra</button>
      </div>
    </dialog>
    <div class="photo-complete" data-photo-complete hidden role="status">
      <img class="photo-complete-korok" src={assets.korok.avif} width={assets.korok.width} height={assets.korok.height} alt="" aria-hidden="true" decoding="async" />
      <div class="photo-complete-bubble">
        <span class="photo-complete-greeting">Foto enviada!</span>
        <span class="photo-complete-text">Você já mandou a sua. +2 XP!</span>
      </div>
    </div>
  </div>
</div>

<script>
  import '../scripts/photo-upload';
</script>

<style>
  .fotos-screen {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding-bottom: clamp(var(--space-3), 3cqh, var(--space-6));
  }

  .photo-panel {
    width:100%;
    padding-inline: var(--space-4);
  }

  .photo-panel-title {
    margin: 0 0 clamp(var(--space-2), 2cqh, var(--space-4));
  }

  .photo-actions {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    text-align: center;
  }

  .photo-actions .button-primary { width: min(100%, 400px); }
  .photo-actions .button-primary[hidden] { display:none; }
  .photo-choices { display:grid; grid-template-columns:1fr 1fr; gap:var(--space-2); width:min(100%, 400px); }
  .photo-choices[hidden] { display:none; }
  .photo-choices .button-primary, .photo-choices .photo-gallery { width:100%; min-width:0; padding-inline:var(--space-2); font-size:14px; }

  .photo-dialog {
    box-sizing: border-box;
    width: min(calc(100% - 2 * var(--space-6)), 340px);
    max-height: calc(100dvh - 2 * var(--space-6));
    margin: auto;
    padding: var(--space-6);
    overflow: auto;
    border: var(--stroke);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: var(--shadow-lift);
  }
  .photo-dialog::backdrop { background: rgb(35 22 16 / 55%); }
  .photo-preview {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    text-align: center;
  }
  .photo-consent { display:flex; gap:var(--space-2); align-items:flex-start; text-align:left; font-size:13px; line-height:1.4; }
  .photo-consent input { flex:none; width:22px; height:22px; margin:0; }
  .photo-dialog-title { margin: 0; font: 700 22px/1.25 var(--font-ui); }
  /* Same language as the Home: Korok beside a rounded cream bubble with a side tail. */
  .photo-complete { display:grid; grid-template-columns:auto minmax(0, 1fr); align-items:end; gap:var(--space-3); width:min(100%, 380px); text-align:left; }
  .photo-complete-korok { width:auto; height:clamp(64px, 10cqh, 88px); }
  .photo-complete-bubble { position:relative; display:grid; gap:2px; padding:var(--space-3) var(--space-5); border:1px solid var(--color-border); border-radius:var(--radius-xl); background:var(--color-surface); box-shadow:var(--shadow-lift); }
  .photo-complete-bubble::before { content:''; position:absolute; left:-8px; top:50%; width:16px; height:16px; border-left:1px solid var(--color-border); border-bottom:1px solid var(--color-border); background:var(--color-surface); transform:translateY(-50%) rotate(45deg); }
  .photo-complete-greeting { color:var(--color-olive); font:italic 700 22px/1.1 var(--font-ui); }
  .photo-complete-text { color:var(--color-text); font-size:15px; font-weight:500; line-height:1.35; }
  @media (prefers-reduced-motion: no-preference) {
    .photo-complete:not([hidden]) .photo-complete-korok { animation:korok-pop 520ms var(--ease-spring) both; }
    .photo-complete:not([hidden]) .photo-complete-bubble { animation:complete-in 360ms var(--ease-standard) 160ms both; }
  }
  @keyframes korok-pop { from { opacity:0; transform:translateY(14px); } }
  @keyframes complete-in { from { opacity:0; transform:translateX(-6px); } }
  .photo-complete[hidden] { display:none; }

  .photo-crop { position:relative; width:min(190px, 30dvh); aspect-ratio:420 / 462; overflow:hidden; touch-action:none; cursor:grab; }
  .photo-crop:active { cursor:grabbing; }
  .photo-crop:focus-visible { outline:3px solid var(--color-focus); outline-offset:3px; }
  .photo-crop[hidden], .photo-crop-hint[hidden] { display:none; }
  .photo-preview-image { position:absolute; inset:9.5% 8% 20.5%; width:84%; height:70%; object-fit:cover; border-radius:2%; user-select:none; }
  .photo-crop-frame { position:absolute; inset:0; width:100%; height:100%; pointer-events:none; user-select:none; }
  .photo-crop-hint { margin:0; color:var(--color-text-secondary); font-size:13px; }

  .photo-preview-status { margin: 0; color: var(--color-text-secondary); font-size: 14px; text-align: center; }

  .button-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: var(--space-2) var(--space-5);
    border: var(--stroke);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-text);
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    box-shadow: 0 2px 0 rgb(59 33 22 / 12%);
    transition: background var(--duration-fast) var(--ease-standard), transform var(--duration-fast) var(--ease-standard), box-shadow var(--duration-fast) var(--ease-standard);
  }
  .button-secondary:hover { background: var(--color-surface-muted); }
  .button-secondary:active { transform: translateY(2px); box-shadow: none; }
  .photo-preview .button-primary { width: 100%; }
</style>
