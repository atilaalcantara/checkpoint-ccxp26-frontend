---
interface Props { title: string; text: string }
const { title, text } = Astro.props;
---

<details class="screen-info">
  <summary aria-label={`Informações sobre ${title}`}><span aria-hidden="true">i</span></summary>
  <div class="info-content">
    <strong>{title}</strong>
    <p>{text}</p>
  </div>
</details>

<script>
  import '../scripts/screen-info';
</script>

<style is:global>
  .info-dialog { width: min(360px, calc(100vw - 40px)); max-height: calc(100dvh - 40px); padding: var(--space-6); border: var(--stroke); border-radius: var(--radius-xl); background: var(--color-surface); color: var(--color-text); box-shadow: var(--shadow-card); }
  .info-dialog::backdrop { background: rgb(59 33 22 / 24%); }
  .info-dialog[open] .info-content p { animation: info-content-in var(--duration-container) var(--ease-container) both; }
  @keyframes info-content-in { from { opacity: 0; } to { opacity: 1; } }
  .info-dialog > .info-content[class] { position: static; width: auto; padding: 0; border: 0; box-shadow: none; background: transparent; }
  .info-close { min-height: 44px; margin-top: var(--space-5); padding: var(--space-2) var(--space-5); border: var(--stroke); border-radius: var(--radius-pill); background: var(--color-olive); color: var(--color-on-primary); }
</style>

<style>
  .screen-info { position: absolute; top: calc(env(safe-area-inset-top) + 12px); right: max(16px, env(safe-area-inset-right)); z-index: 5; }
  summary { display: grid; place-items: center; width: 44px; height: 44px; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary span { display: grid; place-items: center; width: 30px; height: 30px; border: 2px solid var(--color-text); border-radius: 9px; font: 700 20px/1 Georgia, serif; }
  .info-content { position: absolute; right: 0; top: 48px; width: min(280px, calc(100vw - 40px)); padding: var(--space-4); background: var(--color-surface); border: var(--stroke); border-radius: var(--radius-md); box-shadow: var(--shadow-card); color: var(--color-text); }
  .info-content p { margin-top: var(--space-1); font-size: 14px; line-height: 1.5; }
</style>
