---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Checkpoint CCXP26 — Em breve"
  description="Quase lá! O Checkpoint CCXP26 será liberado no dia da CCXP26."
>
  <main id="conteudo" class="soon">
    <img class="logo" src="/assets/branding/checkpoint-ccxp26-logo.c062877445.avif" alt="Checkpoint CCXP26" width="360" height="200" />
    <div class="mascot-composition">
      <img class="mascot" src="/assets/mascot/korok.70b8e471a5.avif" alt="Korok em pixel art" width="120" height="120" />
      <div class="speech-bubble">
        <p><span class="greeting">Yahaha!</span> Estamos quase lá!</p>
        <p>O site será liberado só na <strong>CCXP26</strong>. Volte no grande dia!</p>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .soon {
    min-height: 100dvh;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: var(--space-8);
    padding: var(--space-8) var(--content-gutter);
    background: var(--color-bg);
    color: var(--color-text);
    text-align: center;
  }
  .logo { width: min(100%, var(--logo-max-width)); height: auto; }
  .mascot-composition {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: var(--space-5);
    width: min(100%, var(--content-max));
  }
  .mascot { width: 96px; height: auto; image-rendering: pixelated; }
  .speech-bubble {
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4);
    border: var(--stroke);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    box-shadow: var(--shadow-lift);
    font-family: var(--font-ui);
    line-height: 1.4;
  }
  .speech-bubble::before {
    content: '';
    position: absolute;
    left: calc(-1 * var(--space-2));
    top: 50%;
    width: var(--space-4);
    height: var(--space-4);
    border-left: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
    transform: translateY(-50%) rotate(45deg);
  }
  .speech-bubble p { position: relative; margin: 0; }
  .greeting {
    display: block;
    font-family: var(--font-display);
    font-size: 2rem;
    color: var(--color-olive);
  }
  strong { color: var(--color-olive-deep); }
</style>
